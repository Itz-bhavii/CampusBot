# CampusBot Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
POSTGRES_DB=campusbot
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password_here
DB_URL=jdbc:postgresql://postgres:5432/campusbot
DB_USERNAME=user
DB_PASSWORD=your_secure_password_here

# ===================================================================
# MINIO (Object Storage) CONFIGURATION
# ===================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here
MINIO_URL=http://minio:9000
MINIO_ENDPOINT_URL=http://minio:9000
BUCKET_NAME=campusbot-files

# ===================================================================
# RABBITMQ (Message Broker) CONFIGURATION
# ===================================================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CLOUDAMQP_URL=amqp://guest:guest@rabbitmq:5672/

# ===================================================================
# CHROMADB (Vector Database) CONFIGURATION
# ===================================================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ===================================================================
# AI/ML API KEYS
# ===================================================================
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# ===================================================================
# SERVICE URLS
# ===================================================================
AI_QUERY_SERVICE_URL=http://query-service:8000
